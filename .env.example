# =================================================================
# ResumeAI - Environment Configuration
# =================================================================

# Backend Server Port (Default: 5000)
PORT=5000

# OpenAI API Key (Optional)
# If provided, ResumeAI uses GPT-4o-mini for deep semantic resume analysis.
# If omitted or left empty, ResumeAI seamlessly runs in Demo Mode using its
# built-in deterministic, rule-based ATS analysis engine with zero errors.
OPENAI_API_KEY=

# OpenAI Model (Default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Frontend Client URL (For CORS configuration)
CLIENT_URL=http://localhost:5173
